{
  "name": "vega-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts eslint.config.js --max-warnings=0 && node scripts/verify-boundaries.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "smoke:apps": "pnpm build && node scripts/smoke-apps.mjs",
    "bundle:report": "turbo run build --filter=@vega/web && node scripts/bundle-report.mjs",
    "performance:web": "turbo run build --filter=@vega/web && node scripts/performance-web.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vega/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "lighthouse": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
