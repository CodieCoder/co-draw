{
  "name": "vega-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "infra:up": "node scripts/infra-up.mjs",
    "infra:down": "node scripts/infra-down.mjs",
    "infra:status": "node scripts/infra-status.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx packages/database/src/migrate.ts",
    "db:migrate:status": "node --env-file=.env.local --import tsx packages/database/src/migrate-status.ts",
    "infra:check": "node --env-file=.env.local --import tsx apps/api/src/infra-check.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:foundation": "node scripts/test-integration-foundation.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:cleanup": "node scripts/test-cleanup.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run build && turbo run typecheck && tsc --project tsconfig.json --pretty false",
    "lint": "turbo run lint && eslint scripts tests playwright.config.ts eslint.config.js --max-warnings=0 && node scripts/verify-boundaries.mjs",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "smoke:apps": "pnpm build && node scripts/smoke-apps.mjs",
    "bundle:report": "turbo run build --filter=@vega/web && node scripts/bundle-report.mjs",
    "performance:web": "turbo run build --filter=@vega/web && node scripts/performance-web.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vega/eslint-config": "workspace:*",
    "@vega/test-utils": "workspace:*",
    "@vega/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "lighthouse": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
