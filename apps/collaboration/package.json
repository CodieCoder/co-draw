{
  "name": "@vega/collaboration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false && tsc --project tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hocuspocus/server": "catalog:",
    "@vega/auth": "workspace:*",
    "@vega/collaboration-schema": "workspace:*",
    "@vega/config": "workspace:*",
    "@vega/contracts": "workspace:*",
    "@vega/database": "workspace:*",
    "pg": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vega/typescript-config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
