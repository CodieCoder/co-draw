# =============================================================================
# Vega Canvas — Local Environment Configuration
# =============================================================================
# Copy this file to .env.local and replace every CHANGE_ME placeholder with
# a real local value. Never commit .env.local or any file containing real
# credentials.
#
# All values in this file are intentionally non-usable CHANGE_ME placeholders.
# The application rejects CHANGE_ME and other placeholder values at startup.
# =============================================================================

# ---- Application profile ----
# local | demo | production
APP_PROFILE=local

# ---- Release identifier ----
RELEASE_ID=local-dev

# ---- Public web runtime (Vite) ----
VITE_APP_PROFILE=local
VITE_API_BASE_URL=http://localhost:4000
VITE_COLLABORATION_URL=ws://localhost:1234
VITE_RELEASE_ID=local-dev
VITE_CANVAS_TEST_API_ENABLED=false

# ---- API runtime ----
API_HOST=127.0.0.1
API_PORT=4000
ALLOWED_WEB_ORIGINS=http://localhost:5173

# ---- API-owned PostgreSQL ----
API_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME

# ---- API-owned object storage ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=CHANGE_ME
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ---- Collaboration runtime ----
COLLABORATION_HOST=127.0.0.1
COLLABORATION_PORT=1234

# ---- Collaboration-owned PostgreSQL ----
COLLABORATION_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME

# ---- Collaboration WebSocket URL ----
COLLABORATION_URL=ws://localhost:1234

# ---- Collaboration token signing secret (at least 32 bytes) ----
COLLABORATION_SIGNING_SECRET=CHANGE_ME

# ---- Excalidraw version ----
SUPPORTED_EXCALIDRAW_VERSION=0.18.1

# ---- Migration ----
MIGRATION_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME

# ---- Compose: Local MinIO administration ----
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_CONSOLE_PORT=9001
