{
  "name": "@vega/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "migrate": "node --experimental-sqlite=false --import tsx ./src/migrate.ts",
    "migrate:status": "node --experimental-sqlite=false --import tsx ./src/migrate-status.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "node-pg-migrate": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "@vega/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
