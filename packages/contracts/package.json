{
  "name": "@vega/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./collaboration-token": {
      "types": "./dist/collaboration-token.d.ts",
      "default": "./dist/collaboration-token.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./guest": {
      "types": "./dist/guest.d.ts",
      "default": "./dist/guest.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./identifiers": {
      "types": "./dist/identifiers.d.ts",
      "default": "./dist/identifiers.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "default": "./dist/room.js"
    },
    "./share-links": {
      "types": "./dist/share-links.d.ts",
      "default": "./dist/share-links.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false && tsc --project tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vega/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
